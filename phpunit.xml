<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" backupGlobals="false" colors="true" cacheDirectory=".phpunit.cache" failOnNotice="true" failOnWarning="true">
  <php>
    <ini name="intl.default_locale" value="en"/>
    <ini name="intl.error_level" value="0"/>
    <ini name="memory_limit" value="-1"/>
    <!-- Keep Composer from relocating vendor/ during test runs (use committed tree). -->
    <env name="COMPOSER_VENDOR_DIR" value="vendor" force="true"/>
  </php>
  <testsuites>
    <testsuite name="Plugin Tests">
      <directory>tests/</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">includes/</directory>
      <!-- Adjust to your src dir -->
    </include>
  </source>
</phpunit>
